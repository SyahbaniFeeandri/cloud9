# =============================================================================
# FinCloud — Docker Compose environment template
# =============================================================================
# Copy this file to `.env` and replace every value marked change_me.
# `.env` is gitignored and must never be committed.
#
#   cp .env.example .env
#   chmod 600 .env        # Linux/macOS: owner-only read/write
#
# Generate strong secrets, for example:
#   openssl rand -hex 32
# =============================================================================

# --- Edge / Nginx -----------------------------------------------------------
# Public ports for the central reverse proxy ( / , /api/ , /storage/ ).
# HTTPS uses a self-signed certificate generated automatically by the `certs`
# Compose service on first run (./infra/nginx/certs, gitignored). Replace it
# with a trusted certificate for a public deployment.
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443

# --- MariaDB ----------------------------------------------------------------
MARIADB_ROOT_PASSWORD=
DB_NAME=fincloud_db
DB_USER=webuser
# Application user password. DB_PASSWORD must match MARIADB_PASSWORD.
MARIADB_PASSWORD=
DB_PASSWORD=

# --- Backend ----------------------------------------------------------------
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Comma-separated browser origins allowed to call the API cross-origin.
# Same-origin requests through Nginx work without being listed here.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,https://localhost:8443

# --- MinIO / S3 -------------------------------------------------------------
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Backend credentials must match the MinIO root user above.
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=fincloud-receipts
MINIO_REGION=us-east-1
# Browser-facing URL used to sign receipt links. Point this at the Nginx edge
# (or your public domain in production). The path prefix is stripped by Nginx.
MINIO_PUBLIC_ENDPOINT=localhost
MINIO_PUBLIC_PORT=8080
MINIO_PUBLIC_USE_SSL=false
MINIO_PUBLIC_PATH_PREFIX=/storage
MINIO_PRESIGN_EXPIRES=3600

# --- Monitoring & Logging ---------------------------------------------------
# All ports are bound to 127.0.0.1 only.
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
NODE_EXPORTER_PORT=9100
CADVISOR_PORT=8081
LOKI_PORT=3100
GRAFANA_ADMIN_USER=admin
# Change this before exposing Grafana outside localhost.
GRAFANA_ADMIN_PASSWORD=

# --- Backup & Recovery (scripts/backup.ps1 and scripts/backup.sh) -----------
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=7
# Daily backup time for scripts/install-backup-task.ps1 (HH:mm)
BACKUP_TIME=02:00
