PORT=5000
NODE_ENV=development

# Database MariaDB / MySQL Configuration (local development)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=webuser
DB_PASSWORD=change_me_app_password
DB_NAME=fincloud_db

# Security
JWT_SECRET=change_me_use_openssl_rand_hex_32
JWT_EXPIRES_IN=7d
# Comma-separated browser origins for local frontend development.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Object Storage (MinIO / S3)
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=change_me_minio_user
MINIO_SECRET_KEY=change_me_minio_password
MINIO_BUCKET=fincloud-receipts
MINIO_REGION=us-east-1
# Endpoint reachable from the browser, used to sign receipt URLs.
# Local dev talks to MinIO directly, so no path prefix is needed.
MINIO_PUBLIC_ENDPOINT=127.0.0.1
MINIO_PUBLIC_PORT=9000
MINIO_PUBLIC_USE_SSL=false
MINIO_PUBLIC_PATH_PREFIX=
MINIO_PRESIGN_EXPIRES=3600
